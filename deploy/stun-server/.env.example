# Public DNS name whose A/AAAA record points at this host.
SWARM_DOMAIN=swarm.example.com

# Local builds use this tag. Set a registry reference here when deploying a
# prebuilt image instead, for example ghcr.io/example/swarm-stun-server:v0.1.0.
SWARM_IMAGE=swarm-stun-server:local

# Application log filter.
RUST_LOG=info,sqlx=warn

# Optional SMTP. Leave SWARM_SMTP_HOST unset to disable email delivery and log
# verification/reset links instead. When enabling SMTP, EMAIL_FROM is required.
# SWARM_SMTP_HOST=smtp.example.com
# SWARM_SMTP_PORT=587
# SWARM_SMTP_USERNAME=
# SWARM_SMTP_PASSWORD=
# SWARM_SMTP_STARTTLS=true
# SWARM_EMAIL_FROM=swarm@example.com
# SWARM_EMAIL_FROM_DISPLAY_NAME=SWARM
