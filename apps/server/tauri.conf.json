{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SWARM Server",
  "version": "0.1.0",
  "identifier": "app.swarm.server",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SWARM Server",
        "width": 1040,
        "height": 740,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SWARM-Media-Steaming/swarm/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwQ0JBNDk0Q0EzMjMyRUYKUldUdk1qTEtsS1RMZ0NOOFg0SnYrNjhoWTExTkMycG5lMUM0VURteEtBR2oySGxuNmdzbEFNTXYK"
    }
  }
}
