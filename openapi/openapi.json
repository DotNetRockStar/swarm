                  "$ref": "#/components/schemas/MyDevicesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/swarms": {
      "get": {
        "tags": [
          "swarms"
        ],
        "operationId": "list",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SwarmListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "swarms"
        ],
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSwarmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SwarmSummary"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/swarms/join": {
      "post": {
        "tags": [
          "devices"
        ],
        "operationId": "join_swarm",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinSwarmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SwarmSummary"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/swarms/{swarm_id}": {
      "delete": {
        "tags": [
          "swarms"
        ],
        "operationId": "delete",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
