# These are the current built-in defaults. Copy only values you intend to
# override into the shell environment that launches the foreground scheduler.
SWARM_REPO_DIR=/path/to/swarm
SWARM_ISSUE_WORKER_STATE_DIR=~/.local/state/swarm-issue-worker
SWARM_GITHUB_REPOSITORY=DotNetRockStar/swarm
SWARM_GITHUB_ASSIGNEE=DotNetRockStar
SWARM_TRUSTED_FOLLOWUP_AUTHORS=DotNetRockStar
SWARM_COMPLETION_AUTHORS=DotNetRockStar
SWARM_READY_FOR_TESTING_LABEL=Ready For Testing
SWARM_MIN_REMAINING_PERCENT=10
SWARM_PREFERRED_PROVIDER=claude
SWARM_CLAUDE_MODEL=claude-sonnet-5
SWARM_CODEX_MODEL=gpt-5.6-sol
SWARM_CLAUDE_EFFORT=high
SWARM_CODEX_EFFORT=high
SWARM_EMAIL_TO=mr_jerrodh@hotmail.com
SWARM_SMTP_CREDENTIALS_FILE=/path/to/smtp-settings
SWARM_GITHUB_APPS_CONFIG=~/.config/swarm/github-apps.json
SWARM_REQUIRE_BOT_AUTH=1
SWARM_DELIVERY_MODE=pull-request
SWARM_AUTO_APPROVE=1
SWARM_AUTO_MERGE=1
SWARM_BRANCH_PREFIX=swarm
SWARM_BASE_BRANCH=main
SWARM_GIT_REMOTE=origin
SWARM_PR_MERGE_METHOD=merge
SWARM_GITHUB_HOST=github.com
SWARM_ISSUE_WORKER_INTERVAL_SECONDS=600
SWARM_ISSUE_WORKER_SCHEDULE_MODE=continuous
SWARM_ISSUE_WORKER_SCHEDULE_TIME=09:00
SWARM_ISSUE_WORKER_SCHEDULE_DAYS=mon,tue,wed,thu,fri
SWARM_CARGO_TARGET_MAX_GIB=5
