<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/swarm_bg" />
        </shape>
    </item>
    <!-- Android draws this before MainActivity/Compose exists, eliminating
         the blank window while the client restores its saved connection. -->
    <item
        android:width="160dp"
        android:height="160dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/mascot" />
    </item>
</layer-list>
