<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/swarm_bg" />
        </shape>
    </item>
    <!-- Android draws the same supplied hero used by Compose before
         MainActivity exists, eliminating a blank or mismatched startup frame.
         No width/height here: an item with no explicit size fills the whole
         window, and the bitmap's own fill gravity stretches edge to edge. -->
    <item>
        <bitmap
            android:gravity="fill"
            android:src="@drawable/swarm_hero_portrait" />
    </item>
</layer-list>
