<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/swarm_bg" />
        </shape>
    </item>
    <!-- Android draws the same supplied hero used by Compose before
         MainActivity exists, eliminating a blank or mismatched startup frame. -->
    <item
        android:width="414.4dp"
        android:height="440dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/swarm_hero_portrait" />
    </item>
</layer-list>
