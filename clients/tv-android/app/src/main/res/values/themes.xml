<resources>
    <!-- Compose owns all real theming (see ui/theme). Android displays this
         branded launch drawable before Compose can draw UiState.Loading, so
         cold starts never expose an empty navy/black window. -->
    <style name="Theme.SwarmTv" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:navigationBarColor">@color/swarm_bg</item>
        <item name="android:statusBarColor">@color/swarm_bg</item>
    </style>
</resources>
