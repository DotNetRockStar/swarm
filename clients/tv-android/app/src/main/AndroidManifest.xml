<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Foreground service lands with the peer media proxy (loopback
         HTTP<->QUIC bridge) in a later pass; declared now so the manifest
         shape doesn't need revisiting for Appstore review twice. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Fire TV / Android TV compliance: this app is fully usable with only
         a D-pad remote, so a touchscreen must not be required. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <!-- No microphone/camera features are declared or used. -->

    <application
        android:name="app.swarm.tv.app.SwarmApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SwarmTv"
        android:usesCleartextTraffic="false">

        <!-- Fully qualified, not ".MainActivity": `namespace` above is
             "app.swarm.tv" but this module's actual Kotlin package is
             "app.swarm.tv.app" (one segment deeper) — a relative name
             here resolves against `namespace`, landing on the
             nonexistent "app.swarm.tv.MainActivity" and throwing
             ClassNotFoundException at launch even though the real class
             is right there in the APK. Confirmed the hard way on a real
             Fire TV 4-Series: this alone was the entire crash, unrelated
             to multidex/dex-sharding despite how that looked at first —
             see swarm-real-device-debugging skill for the full story
             before spending time on dex placement for a class-not-found
             crash again. -->
        <activity
            android:name="app.swarm.tv.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.SwarmTv">
            <!-- LEANBACK_LAUNCHER, not just MAIN/LAUNCHER, is what makes
                 this app appear on the Fire TV / Android TV home screen
                 rather than requiring sideload-only launch. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
