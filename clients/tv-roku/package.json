{
  "name": "swarm-tv-roku",
  "version": "0.1.0",
  "private": true,
  "description": "SWARM media client for Roku (BrighterScript + SceneGraph)",
  "scripts": {
    "build": "bsc --project bsconfig.json",
    "watch": "bsc --project bsconfig.json --watch",
